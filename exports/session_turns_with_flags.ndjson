{"session_id": "SESS_2001", "overall_verdict": "CLEAN", "review_status": "LOCKED", "astrotalk_flagged": 0, "turns": [{"turn_id": 1, "speaker": "USER", "is_automated": 0, "timestamp": "2026-07-16T10:00:00+00:00", "message_text": "Hello, I wanted to ask about my career growth this year.", "has_active_flag": false, "active_flag_count": 0, "active_flag_categories": []}, {"turn_id": 2, "speaker": "ASTROLOGER", "is_automated": 1, "timestamp": "2026-07-16T10:00:00+00:00", "message_text": "Namaste. Please share your date and time of birth so I can look at your chart.", "has_active_flag": false, "active_flag_count": 0, "active_flag_categories": []}, {"turn_id": 3, "speaker": "USER", "is_automated": 0, "timestamp": "2026-07-16T10:01:00+00:00", "message_text": "12 March 1994, around 6:30 in the morning, in Pune.", "has_active_flag": false, "active_flag_count": 0, "active_flag_categories": []}, {"turn_id": 4, "speaker": "ASTROLOGER", "is_automated": 0, "timestamp": "2026-07-16T10:02:00+00:00", "message_text": "Thank you. Jupiter is favourable for you this year, so a promotion or job change looks likely after October.", "has_active_flag": false, "active_flag_count": 0, "active_flag_categories": []}, {"turn_id": 5, "speaker": "USER", "is_automated": 0, "timestamp": "2026-07-16T10:03:00+00:00", "message_text": "That is reassuring. Should I wait before switching jobs?", "has_active_flag": false, "active_flag_count": 0, "active_flag_categories": []}, {"turn_id": 6, "speaker": "ASTROLOGER", "is_automated": 0, "timestamp": "2026-07-16T10:03:00+00:00", "message_text": "Yes, waiting until the Jupiter transit strengthens will give you a better offer. Stay patient and keep improving your skills.", "has_active_flag": false, "active_flag_count": 0, "active_flag_categories": []}]}
{"session_id": "SESS_2002", "overall_verdict": "CLEAN", "review_status": "LOCKED", "astrotalk_flagged": 0, "turns": [{"turn_id": 1, "speaker": "USER", "is_automated": 0, "timestamp": "2026-07-16T11:15:00+00:00", "message_text": "Namaste ji, I want to understand about my marriage timing.", "has_active_flag": false, "active_flag_count": 0, "active_flag_categories": []}, {"turn_id": 2, "speaker": "ASTROLOGER", "is_automated": 1, "timestamp": "2026-07-16T11:15:00+00:00", "message_text": "Welcome. May I know your name and birth details please?", "has_active_flag": false, "active_flag_count": 0, "active_flag_categories": []}, {"turn_id": 3, "speaker": "USER", "is_automated": 0, "timestamp": "2026-07-16T11:16:00+00:00", "message_text": "My name is Ananya, born 5 August 1996 in Jaipur at 9 pm.", "has_active_flag": false, "active_flag_count": 0, "active_flag_categories": []}, {"turn_id": 4, "speaker": "ASTROLOGER", "is_automated": 0, "timestamp": "2026-07-16T11:17:00+00:00", "message_text": "Your seventh house is well placed, Ananya. A suitable match is indicated between mid-2027 and early 2028.", "has_active_flag": false, "active_flag_count": 0, "active_flag_categories": []}, {"turn_id": 5, "speaker": "USER", "is_automated": 0, "timestamp": "2026-07-16T11:18:00+00:00", "message_text": "Will it be an arranged or love marriage?", "has_active_flag": false, "active_flag_count": 0, "active_flag_categories": []}, {"turn_id": 6, "speaker": "ASTROLOGER", "is_automated": 0, "timestamp": "2026-07-16T11:18:00+00:00", "message_text": "The signs lean towards an introduction through family or friends. Keep an open mind and it will work out well.", "has_active_flag": false, "active_flag_count": 0, "active_flag_categories": []}]}
